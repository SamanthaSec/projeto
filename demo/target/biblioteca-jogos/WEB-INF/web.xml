<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0" metadata-complete="true">
    <display-name>biblioteca-jogos</display-name>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>br.com.jogos.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/jogos/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/categorias/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>JogoController</servlet-name>
        <servlet-class>br.com.jogos.controller.JogoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JogoController</servlet-name>
        <url-pattern>/api/jogos/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoriaController</servlet-name>
        <servlet-class>br.com.jogos.controller.CategoriaController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoriaController</servlet-name>
        <url-pattern>/api/categorias/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>br.com.jogos.controller.AuthController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>login.html</welcome-file>
    </welcome-file-list>
</web-app>
